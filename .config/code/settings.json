{
    "breadcrumbs.enabled": false,
    "chat.disableAIFeatures": true,
    "chat.extensionTools.enabled": false,
    "debug.console.fontFamily": "Monaco, Consolas",
    "debug.console.fontSize": 14,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.codeLens": false,
    "editor.colorDecorators": false,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.cursorBlinking": "solid",
    "editor.cursorWidth": 2,
    "editor.dragAndDrop": false,
    "editor.folding": false,
    "editor.fontFamily": "Monaco, Consolas",
    "editor.fontSize": 14,
    "editor.language.colorizedBracketPairs": [],
    "editor.minimap.enabled": false,
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.occurrencesHighlight": "off",
    "editor.renderLineHighlight": "gutter",
    "editor.rulers": [80, 120],
    "editor.selectionHighlight": false,
    "editor.stickyScroll.enabled": false,
    "editor.wordWrapColumn": 80,
    "editor.wrappingIndent": "same",
    "explorer.autoReveal": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "extensions.ignoreRecommendations": true,
    "files.enableTrash": false,
    "files.eol": "\n",
    "files.exclude": {
        "**/node_modules": true
    },
    "files.hotExit": "off",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "git.openRepositoryInParentFolders": "never",
    "go.coverOnSave": false,
    "go.lintOnSave": "off",
    "go.lintTool": "golangci-lint-v2",
    "go.testFlags": ["-count=1", "-benchtime=1m", "-cover"],
    "go.testTimeout": "1m",
    "go.toolsManagement.autoUpdate": true,
    "go.useLanguageServer": true,
    "go.vetOnSave": "off",
    "gopls": {
        "formatting.gofumpt": true
    },
    "problems.autoReveal": false,
    "problems.decorations.enabled": false,
    "redhat.telemetry.enabled": false,
    "scm.inputFontFamily": "Monaco, Consolas",
    "scm.inputFontSize": 14,
    "security.workspace.trust.enabled": false,
    "telemetry.feedback.enabled": false,
    "telemetry.telemetryLevel": "off",
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "terminal.integrated.fontFamily": "Monaco, Consolas",
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.initialHint": false,
    "update.showReleaseNotes": false,
    "window.confirmSaveUntitledWorkspace": false,
    "window.restoreWindows": "none",
    "workbench.colorTheme": "Monokai Night",
    "workbench.commandPalette.history": 0,
    "workbench.editor.empty.hint": "hidden",
    "workbench.editor.useModal": "off",
    "workbench.startupEditor": "none",
    "workbench.tips.enabled": false,
    "xml.server.vmargs": "-Xmx64M",
    "xml.validation.enabled": false,
    "[markdown]": {
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "editor.unicodeHighlight.invisibleCharacters": false,
        "editor.wordWrap": "wordWrapColumn"
    },
    "[plaintext]": {
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "editor.unicodeHighlight.invisibleCharacters": false,
        "editor.wordWrap": "wordWrapColumn"
    }
}
